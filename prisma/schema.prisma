// Kodely — Phase 1 data model.
// Principles baked in here (see the Kodely board):
//  - every generation is a Build row with real token counts, so cost per build is never a guess
//  - credits are a ledger, never a mutable counter: the balance is derivable and auditable
//  - failed builds are recorded but NEVER charged

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  // Nullable because a Google-only account never sets a local password.
  passwordHash     String?
  googleId         String?  @unique
  name             String?
  role             String   @default("CUSTOMER") // CUSTOMER | ADMIN
  stripeCustomerId String?
  createdAt        DateTime @default(now())

  // Self-imposed ceiling on credits spent per rolling 30 days. NULL = no cap.
  // This is the user's own guard against a runaway session, not a plan limit —
  // bill shock is the category's deepest trust wound (one competitor billed
  // $607 against a $25 plan in three days), and a cap the user sets themselves
  // is the cheapest honest answer to it.
  spendCapCredits Int?

  // Set when the user asks for erasure, cleared if they cancel. The grace
  // period is measured from here.
  //
  // Exists because the alternative was worse: the request was being recorded as
  // marker-prefixed SupportNote rows, which then appeared in an operator-notes
  // UI that describes itself as "operator-written, never customer-facing" — one
  // of those rows was neither. A lifecycle fact belongs on the user, not
  // smuggled into a table meant for something else.
  deletionRequestedAt DateTime?

  // ── Nxeon (domains / VPS / shared hosting), all optional ──────────────────
  //
  // @unique because two Kodely accounts silently sharing one Nxeon identity
  // is a support incident waiting to happen (whose wallet, whose server?) —
  // the callback treats a collision as a hard error, never a second link.
  //
  // Deliberately flat fields rather than a child table: Nxeon provisions AT
  // MOST one of each product per Kodely account today (the checkout call
  // carries no slot/index), so a one-row-per-user shape cannot under- or
  // over-count. Revisit as a table only if Nxeon ever lets one account hold
  // more than one server, domain or hosting account.
  //
  // IMPORTANT — what this does NOT do: buying a domain here does not point it
  // at a Kodely site, and provisioning a VPS/hosting account here does not
  // deploy the Kodely-built site onto it. Nxeon's API (see lib/nxeon.ts)
  // covers identity linking, checkout and provisioning notification only —
  // actually shipping generated files onto Nxeon infrastructure is unbuilt
  // and is a separate piece of work.
  nxeonUserId String? @unique

  nxeonServerId       String?
  nxeonServerIp       String?
  nxeonServerHostname String?

  nxeonDomain          String?
  nxeonDomainExpiresAt DateTime?

  nxeonHostingAccountId String?
  nxeonHostingDomain    String?

  sessions     Session[]
  projects     Project[]
  ledger       CreditLedger[]
  events       Event[]
  supportNotes SupportNote[]
  supportTickets SupportTicket[]
}

// Idempotency guard for Nxeon's webhook, same shape and same reason as
// StripeEvent: `id` is the primary key, so a retried or duplicated delivery
// hits a P2002 conflict and is skipped rather than applied twice. An HMAC
// signature proves the request came from Nxeon; it says nothing about whether
// we have already handled this exact delivery.
model NxeonEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

// First-party analytics. Self-hosted deliberately: cheaper, keeps the data
// ours, avoids another paid API on the critical path, and is privacy-clean.
//
// One wide table rather than a table per dashboard, because the activation
// funnel, retention cohorts, per-user journey, attribution and the overview
// tiles are all different queries over the same stream. Build it once, or
// every dashboard invents its own tracking.
model Event {
  id     String  @id @default(cuid())
  // Nullable so pre-signup events (landing view, prompt submitted) still land.
  userId String?
  /// Dotted, past-tense name — see EVENTS in lib/events.ts. Never free text.
  name   String
  /// Small, non-PII payload: ids, counts, enum-ish strings. Never prompt bodies.
  props  Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Funnels scan by name over a window; journeys scan one user over a window.
  @@index([name, createdAt])
  @@index([userId, createdAt])
}

// A submission from a form on a PUBLISHED generated site.
//
// This is the one deliberate hole in "generated sites have no backend", and it
// exists because the alternative is worse: the builder is currently forbidden
// from drawing a contact form at all, because a form that silently discards a
// real enquiry is worse than no form — and a live blog post already told dental
// practices their appointment requests were arriving when they were not.
//
// Submissions land HERE, on Kodely's origin, never on the customer's site. The
// generated page stays static; only the POST target is ours.
model FormSubmission {
  id        String   @id @default(cuid())
  projectId String
  /// Which form on the page, when a site has more than one.
  formName  String   @default("contact")
  /// The submitted fields. Untrusted public input — never rendered as HTML,
  /// never interpolated into a query, and capped hard at write time.
  fields    Json
  /// For rate limiting and abuse triage only. Not shown to the site owner.
  ipHash    String?
  createdAt DateTime @default(now())

  readAt DateTime?
  /// Set when it looks like spam. Kept rather than dropped, so a false
  /// positive is recoverable and the rate is measurable.
  spam   Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([createdAt])
}

// A generic record written back by a PUBLISHED generated site — the storage
// primitive behind "Phase 0" of real backend-backed site features (bookings,
// client portals, simple data), generalising FormSubmission the same way
// `/__records/<kind>` generalises `/__forms/<name>`. See lib/site-records.ts.
//
// This model carries NO product logic: `kind` is an arbitrary short
// identifier chosen by whatever the builder generates (a form, a listing, a
// booking, a CRM row — anything), and `fields` is an arbitrary JSON payload
// under the same write-time discipline as FormSubmission.fields (validated
// key names, capped sizes). Nothing here assumes a shape, checks for
// conflicts, or knows what a "booking" or a "listing" is — that is
// deliberately future work, not this table's job.
model SiteRecord {
  id        String   @id @default(cuid())
  projectId String
  /// Which kind of record this is, when a site writes more than one — e.g.
  /// "booking", "listing", or anything else a generated site invents. Same
  /// regex discipline as FormSubmission.formName; validated at the endpoint,
  /// never trusted as-is.
  kind      String
  /// The record's own payload. Untrusted public input — never rendered as
  /// HTML, never interpolated into a query, and capped hard at write time,
  /// exactly like FormSubmission.fields.
  fields    Json
  /// Lets a record be superseded or cancelled without deleting history.
  /// "active" until something later gives it a reason to change; Phase 0
  /// writes nothing else here.
  status    String   @default("active")
  /// For rate limiting and abuse triage only. Not shown to the site owner.
  /// Same salted-hash approach as FormSubmission.ipHash.
  ipHash    String?
  /// Set when it looks like spam, same honeypot-flag pattern as
  /// FormSubmission.spam. Kept rather than dropped, so a false positive is
  /// recoverable and the rate is measurable.
  spam      Boolean  @default(false)
  /// SHA-256 of a random per-record token, salted the same way ipHash is
  /// (see RECORD_EDIT_TOKEN_SALT in lib/site-records.ts). Never the raw
  /// token — that is handed to the submitter exactly once, in the reply
  /// page, and never stored. Null for a record created before this column
  /// existed, or if generation somehow failed; either way, a null hash
  /// simply means no visitor-facing manage link works for that row — the
  /// project owner can still act on it from the authenticated dashboard.
  editTokenHash String?
  /// Which visitor (if any) created this record — stamped ONLY when a valid
  /// SiteSession cookie was present on the same-origin POST that created it
  /// (see resolveSiteVisitor()/submitSiteRecord() in lib/site-auth.ts and
  /// lib/site-records.ts). Null for every anonymous submission, which remains
  /// the common case: this is an optional linkage, never a new requirement on
  /// what a record can be. Cascade: a visitor's own rows disappear with them,
  /// matching SiteSession/SiteLoginToken below — none of this is retained
  /// data the project owner has an independent claim to once the visitor
  /// (and their per-project identity) is gone.
  siteVisitorId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteVisitor SiteVisitor? @relation(fields: [siteVisitorId], references: [id], onDelete: Cascade)

  // The owner's list view (filtered by kind) and the per-project rate-limit
  // queries both scan this shape.
  @@index([projectId, kind, createdAt])
  // data-kodely-mine's read path: "this kind, this visitor" — see
  // renderSiteRecords() in lib/site-record-render.ts.
  @@index([projectId, kind, siteVisitorId])
}

// ── Visitor accounts on a PUBLISHED generated site — magic-link only ────────
//
// A COMPLETELY SEPARATE trust domain from Kodely's own portal auth (User /
// Session / lib/auth.ts, above): a visitor signing into a generated site at
// <slug>.kodely.site is a stranger to Kodely who happens to be looking at one
// customer's site, never a Kodely account holder, and must never be
// confusable with one. Hence dedicated tables (not User/Session), a
// dedicated cookie (kodely_site_session, never kodely_session), and no
// identity linking across projects: the same email on two different
// generated sites is two different, uncorrelated SiteVisitor rows, which
// keeps this simple and avoids a real cross-site privacy/correlation
// problem. See lib/site-auth.ts.
//
// Passwords are NEVER part of this system, on purpose — see the header
// comment in lib/site-auth.ts for why magic-link is the only option the
// builder model is ever taught.
model SiteVisitor {
  id        String   @id @default(cuid())
  projectId String
  email     String
  createdAt DateTime @default(now())

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  loginTokens SiteLoginToken[]
  sessions    SiteSession[]
  records     SiteRecord[]

  // One identity per (project, email) — the find-or-create in
  // requestSiteLogin() relies on this being enforceable, not just conventional.
  @@unique([projectId, email])
}

// A one-time, time-limited magic-link token — the ENTIRE authentication
// mechanism for a site visitor. Never a password, never anything a visitor
// chooses or types beyond their email address.
model SiteLoginToken {
  id            String    @id @default(cuid())
  siteVisitorId String
  /// Salted SHA-256 of the raw token mailed to the visitor — same discipline
  /// as SiteRecord.editTokenHash (RECORD_EDIT_TOKEN_SALT) and Session.tokenHash
  /// in lib/auth.ts: the raw value is handed out exactly once, by email, and
  /// never stored.
  tokenHash String
  /// 15 minutes from creation. A magic link is meant to be used within the
  /// same browsing session it was requested in, not saved for later — a much
  /// tighter window than SiteSession's 30 days deliberately, since this token
  /// alone is what proves the email was really read.
  expiresAt DateTime
  /// Null until consumed, then stamped — the one-time-use guard. A used (or
  /// expired) token must never authenticate again; verifySiteLogin() checks
  /// both.
  usedAt DateTime?

  siteVisitor SiteVisitor @relation(fields: [siteVisitorId], references: [id], onDelete: Cascade)

  // The verify lookup is "find by tokenHash" — same shape as
  // Session.tokenHash's unique index, but not unique here: a NEW token is
  // minted on every login request rather than reusing/rotating one row (an
  // old, still-live token from an earlier request must keep working, or
  // resending a link would silently invalidate the one already in the
  // visitor's inbox), and two independently-random 256-bit tokens colliding
  // is not a real possibility worth a unique constraint over.
  @@index([tokenHash])
}

// The actual signed-in session behind the kodely_site_session cookie —
// mirrors Session in lib/auth.ts in shape, deliberately not in table.
model SiteSession {
  id            String   @id @default(cuid())
  siteVisitorId String
  /// Denormalised from siteVisitor.projectId, mirroring FormSubmission's own
  /// denormalisation habit — resolveSiteVisitor() (the GET route's per-request
  /// "who is this" check, and the record-creation stamping path) needs a
  /// fast, single-column "is this session valid FOR THIS PROJECT" test, and
  /// without this it would need a join on every request that only exists to
  /// re-derive a value that can never change for a given session.
  projectId String
  /// Salted SHA-256 of the raw cookie value. Same reasoning as every other
  /// token hash in this file: a database read never yields a usable cookie.
  tokenHash String   @unique
  /// 30 days from creation — same lifetime as the portal's own Session, and
  /// for the same reason (SESSION_DAYS in lib/auth.ts): long enough that a
  /// returning visitor stays signed in, refreshed by signing in again via a
  /// fresh magic link rather than by any rolling-renewal logic here.
  expiresAt DateTime
  createdAt DateTime @default(now())

  siteVisitor SiteVisitor @relation(fields: [siteVisitorId], references: [id], onDelete: Cascade)

  // resolveSiteVisitor()'s only query: "this hash, still valid, for this
  // project" — tokenHash is already unique above, but the project scope is
  // what actually enforces that a session minted on Site A can never resolve
  // a visitor "for" Site B, so it earns its own index rather than relying on
  // the unique one alone.
  @@index([projectId, tokenHash])
}

// Pre-auth attempt counter for login and signup.
//
// Exists because the limiter that guards them cannot key on a user id — there
// is no session yet — and every other limiter in lib/rate-limit.ts counts rows
// the feature already writes (Build, Project). A failed login writes nothing,
// so without this table the counter can only live in process memory, where it
// resets on every deploy and multiplies by the process count.
//
// `key` is the bucket, already hashed by the caller: an IP, or a salted digest
// of an email. Deliberately never the plaintext address — this table would
// otherwise become a running list of every address anyone tried to log in as,
// which is a worse thing to hold than the problem it solves.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  /// "ip" | "account" | "signup" — so one table serves every pre-auth bucket
  /// without the scopes colliding on a shared key.
  scope     String
  createdAt DateTime @default(now())

  // The only query shape: count rows for one bucket inside a window, and prune
  // everything older. Both are served by this index.
  @@index([scope, key, createdAt])
  @@index([createdAt])
}

// One row per transactional email actually sent.
//
// Without this, notification idempotency has to be derived from a time window,
// which is at-most-once: a skipped cron run drops that window, and a process
// restart mid-window can resend. The unique constraint below makes it
// exactly-once — the insert IS the claim, so two workers racing produce one
// email and one conflict.
//
// `dedupeKey` is the id of the thing that triggered it (the ledger row that
// dropped someone into "low", the failed build, the project first published),
// NOT a timestamp. That is what makes the guarantee independent of scheduling.
model EmailLog {
  id        String   @id @default(cuid())
  userId    String
  /// welcome | low_credits | build_failed | site_published
  kind      String
  dedupeKey String
  sentAt    DateTime @default(now())

  @@unique([kind, dedupeKey])
  @@index([userId, sentAt])
}

// Who did what in the admin panel. Admin surfaces read cost, margin, customer
// prompts and personal data; without a log, "who looked at this account" has no
// answer. Append-only by convention — nothing in the app updates or deletes a row.
model AdminAuditLog {
  id         String   @id @default(cuid())
  /// The admin who acted. Kept as a plain id, not a relation, so the record
  /// survives that admin's account being deleted.
  actorId    String
  actorEmail String
  /// Dotted, past-tense: "user.viewed", "site.taken_down", "flag.changed".
  action     String
  targetType String?
  targetId   String?
  /// Small, non-PII context. Never prompt bodies or generated content.
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// Runtime kill switches and gradual rollout. Deliberately a table rather than
// env vars: flipping a flag must not require a deploy, which is the entire
// point of having a kill switch.
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String   @default("")
  /// 0-100. Ignored when `enabled` is false. Bucketed by user id so a given
  /// user's answer is stable rather than flickering between requests.
  rolloutPct  Int      @default(100)
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

// One row per moderation finding per publish attempt. Sub-blocking findings
// previously went only to console.warn — enough to reconstruct one site after
// it is reported, not enough to query proactively, and not enough to ever
// measure the false-positive rate that gates promoting a rule to blocking.
model ModerationFinding {
  id        String   @id @default(cuid())
  projectId String
  rule      String
  severity  String // high | medium | low
  path      String
  evidence  String
  /// "blocked" when this finding stopped the publish, "recorded" otherwise.
  action    String
  createdAt DateTime @default(now())

  reviewedAt DateTime?
  reviewedBy String?
  /// Set on review: "true_positive" | "false_positive".
  outcome    String?

  @@index([projectId, createdAt])
  @@index([severity, createdAt])
  @@index([rule, createdAt])
}

// Operator-written notes about a customer, for support continuity. Never shown
// to the customer, so it must never be used to store anything we would not
// stand behind if disclosed in a data-subject access request.
model SupportNote {
  id          String   @id @default(cuid())
  userId      String
  authorEmail String
  body        String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ── Support tickets: a conversation WITH the customer ─────────────────────
//
// SupportNote (above) and SupportMessage (below) are NOT the same thing and
// must never be merged, however similar the columns look:
//
//   SupportNote     operator prose ABOUT a person. Written by staff, read by
//                   staff, NEVER rendered to the customer. It is disclosable
//                   in a subject access request — the export returns its body
//                   — but disclosure-on-request and publication-in-the-UI are
//                   different things, and only the first one applies here.
//   SupportMessage  one turn of a conversation WITH a person. Either side may
//                   have written it, and EVERY row of it — including the ones
//                   staff wrote — is rendered in that customer's own thread on
//                   /support the moment it is created.
//
// So the safety property is: a staff SupportMessage is published to the
// customer by construction, and a SupportNote never is. Anything an operator
// would only write because the customer cannot see it belongs in a note. If a
// note ever needs to become an answer, it has to be re-written as a message on
// purpose; nothing in the app copies between the two tables, in either
// direction, and nothing should.
//
// Both are destroyed on erasure (app/api/account/_deletion.ts) and both appear
// in the data export.
model SupportTicket {
  id     String @id @default(cuid())
  userId String

  /// bug | feature | billing | help. Closed set — SUPPORT_CATEGORIES in
  /// lib/support.ts is the contract, and the sidebar's "Bug or idea" menu
  /// links straight at two of them via /support?topic=…
  category String @default("help")
  subject  String

  /// OPEN | ANSWERED | RESOLVED. Three, because only three are real: OPEN and
  /// ANSWERED are derived from who wrote last (nobody types them), and
  /// RESOLVED is the one a human sets. There is deliberately no "pending", no
  /// "escalated" and no priority column — nothing measures or acts on any of
  /// them, and a status nobody sets is a status that lies.
  status String @default("OPEN")

  /// Which site this is about, when it is about one. SetNull rather than
  /// Cascade: deleting a project must not destroy the ticket that explains why
  /// it was deleted, and a thread whose site is gone still reads correctly.
  projectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// When the newest message on the thread landed. The list ORDER, kept
  /// separate from `updatedAt` on purpose: `updatedAt` also moves when someone
  /// merely opens the thread (the read marks below are updates), and a list
  /// that reshuffles because a page was viewed is a list you cannot trust.
  lastMessageAt DateTime @default(now())

  /// When staff last replied. NULL means nobody has. Denormalised so "is there
  /// an unread reply" is answerable for a whole page of tickets without a join
  /// per row; written in the same transaction as the message it describes.
  lastStaffMessageAt DateTime?

  // ── Read state, both sides. Neither is derivable from the other. ──────────
  /// When the customer last opened this thread. `lastStaffMessageAt` newer
  /// than this is what puts "New reply" on their list.
  customerReadAt DateTime?
  /// When an operator last opened it. With status OPEN — which is exactly the
  /// case where the last message is the customer's — this is what separates
  /// "nobody has looked at this yet" from "seen, not yet answered".
  staffReadAt DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  // The customer's own list, the admin's status filter, and the admin's
  // unfiltered list. All three sort by lastMessageAt desc.
  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
}

model SupportMessage {
  id       String @id @default(cuid())
  ticketId String

  /// CUSTOMER | STAFF. A string rather than a boolean because "isStaff: false"
  /// reads as an absence, and the one thing this column must never be is
  /// ambiguous — it decides whose name goes on a message the customer reads.
  author String

  /// The operator's email AS IT WAS when they replied, denormalised the same
  /// way AdminAuditLog.actorEmail is, so the record survives that admin's
  /// account being deleted. NULL on a customer message: the ticket's userId
  /// already identifies them, and a second copy of a customer's address is
  /// personal data with no job.
  ///
  /// NEVER SHOWN TO THE CUSTOMER. Their thread says "Kodely support" — a staff
  /// member's address is another person's contact detail, which is the same
  /// reason the data export withholds SupportNote.authorEmail.
  staffEmail String?

  /// Plain text, capped at write time. Rendered with whitespace preserved and
  /// never as HTML — customer input on one side, and on the other a string an
  /// operator typed that lands in a customer's browser.
  body String

  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// Every processed Stripe webhook event, keyed by Stripe's own event id.
// This is the idempotency guard: a webhook retry (Stripe resends on any
// non-2xx or timeout) must never grant credits twice for the same payment.
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  slug      String   @unique // becomes <slug>.kodely.site when published
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishedAt DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       ProjectFile[]
  messages    Message[]
  builds      Build[]
  submissions FormSubmission[]
  records     SiteRecord[]
  // SetNull, not Cascade — see SupportTicket.projectId. Deleting a site must
  // not silently delete the conversation about why it was broken.
  supportTickets SupportTicket[]
  siteVisitors   SiteVisitor[]

  @@index([userId])
}

// The working tree of a generated project. `published` files are the live
// snapshot served on the public subdomain; draft files are what the preview shows.
// `kind` separates the two file universes that live in this one table:
// "source" is the real Vite+React+TS project the agent edits (never served
// directly — a browser can't run raw .tsx); "build" is the compiled static
// output (lib/build-site.ts) that preview/publish/site-serving actually read.
model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String
  content   String
  published Boolean  @default(false)
  kind      String   @default("source") // "source" | "build"
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path, published, kind])
  @@index([projectId])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Build {
  id        String    @id @default(cuid())
  projectId String
  status    String    @default("RUNNING") // RUNNING | SUCCEEDED | FAILED
  model     String
  prompt    String
  error     String?
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)
  filesWritten     Int @default(0)

  // How many times the build had to be repaired before it compiled. 0 means it
  // compiled first try. This is the instrument for "green-build-first-try",
  // which the roadmap names as a kill-criterion gating the jump to backend
  // work — and which, until now, nothing measured. Retries are also the
  // clearest early signal of prompt or model regressions.
  repairAttempts Int @default(0)

  // Full draft file tree AFTER this build finished. Small sites, so a JSON
  // snapshot per successful build is cheap and makes rollback a plain restore
  // instead of needing per-file version history.
  //
  // SHAPE — this comment said `{path: content}` until 2026-08-22 and that was
  // WRONG. It is two file universes, written in app/api/generate/route.ts and
  // read in app/projects/[id]/page.tsx:
  //
  //   { source: { "src/App.tsx": "…" }, build: { "index.html": "…" } }
  //
  // `source` is the real Vite project the agent edits; `build` is the compiled
  // output actually served. The wrong comment already cost one reader real
  // time — they believed it, reported "2 files, 277 KB", and only found the
  // truth by querying live rows (18 source + 3 build). Trust the code.
  filesSnapshot Json?

  // Real model spend in micro-dollars, and what we actually charged.
  costMicros     Int @default(0)
  creditsCharged Int @default(0)

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ledger  CreditLedger[]

  @@index([projectId])
}

model CreditLedger {
  id          String   @id @default(cuid())
  // Nullable, and SetNull rather than Cascade, so erasing an account does not
  // erase the financial record. Three reasons, all load-bearing:
  //
  //  1. lib/retention.ts lists this table as NEVER_PRUNED — "retained
  //     permanently" — and every balance in the product is derived from it.
  //  2. identityAlreadyUsed() in app/api/rewards/_lib.ts enforces one reward
  //     per external social account by scanning `reason` strings GLOBALLY.
  //     Cascading these away turns "delete, re-register, reconnect the same
  //     Discord" into an unlimited credit farm at real model spend per cycle.
  //  3. `stripe:<checkout_session_id>` rows are the record of money received.
  //
  // What survives a deletion is a delta, a reason, a balance and a date, with
  // no user attached — see app/api/account/_deletion.ts.
  userId      String?
  delta       Int // negative = spend, positive = grant/refund
  reason      String
  buildId     String?
  balanceAfter Int
  createdAt   DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  build Build? @relation(fields: [buildId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// SEO content pages (comparisons, guides, use-cases, glossary, feature pages,
// personas — see the "SEO · *" board columns). bodyHtml is pre-rendered,
// hand-authored semantic HTML, not user input or markdown rendered at
// runtime — there's no templating/interpolation risk serving it directly.
model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  metaDescription String
  category        String // matches the board column, e.g. "Comparisons", "Guides"
  targetKeyword   String
  bodyHtml        String
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
}
